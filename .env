# Django Temel Ayarları
SECRET_KEY=django-insecure-your-actual-secret-key-here
DEBUG=True
ALLOWED_HOSTS=anatoliabox.store,api.anatoliabox.store,admin.anatoliabox.store,localhost,127.0.0.1

# Veritabanı (PostgreSQL) Yapılandırması
DB_NAME=sanal_kurye_db
DB_USER=kurye_admin
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432

# Güvenlik Ayarları
CSRF_TRUSTED_ORIGINS=https://admin.anatoliabox.store,https://api.anatoliabox.store,http://localhost:8000
SESSION_COOKIE_DOMAIN=.anatoliabox.store
