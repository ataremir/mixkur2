# Django Temel Ayarları
SECRET_KEY=django-insecure-your-actual-secret-key-here
DEBUG=True
ALLOWED_HOSTS=anatoliabox.store,api.anatoliabox.store,admin.anatoliabox.store,isletme.anatoliabox.store,localhost,127.0.0.1

# Veritabanı (PostgreSQL) Yapılandırması
DB_NAME=sanal_kurye_db
DB_USER=kurye_admin
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432

# Güvenlik Ayarları
CSRF_TRUSTED_ORIGINS=https://admin.anatoliabox.store,https://api.anatoliabox.store,https://isletme.anatoliabox.store,http://localhost:8000
SESSION_COOKIE_DOMAIN=.anatoliabox.store

# Telegram Bot Ayarları
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_COURIER_GROUP_ID=-1001234567890

# Redis / Celery (Asenkron Görevler)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Sabit Kurye Ücreti (₺)
DEFAULT_DELIVERY_FEE=50.00
